# ===== Tiệm nhà Cam — cấu hình (copy thành .env rồi sửa) =====

# Bắt buộc đổi khi deploy: chuỗi ngẫu nhiên dài, tạo bằng:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

SITE_NAME=Tiệm nhà Cam
SITE_URL=https://thue.example.com
# Đặt 1 khi chạy sau HTTPS (nginx + certbot) để cookie phiên chỉ gửi qua HTTPS
SESSION_HTTPS_ONLY=0

# Dữ liệu (SQLite + ảnh upload)
DATA_DIR=./data
MAX_UPLOAD_MB=8

# 1 = tự tạo dữ liệu demo khi DB trống; 0 khi chạy thật
AUTO_SEED=1
# 1 = hiện banner "bản demo" + tài khoản demo ở trang đăng nhập
DEMO_MODE=1

# Phí nền tảng (%)
SERVICE_FEE_PCT=8
HOST_FEE_PCT=3
PENDING_EXPIRE_HOURS=24

# Thanh toán chuyển khoản VietQR (để trống = ẩn mã QR). BANK_ID: VCB, MB, TCB, ACB... hoặc mã BIN
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Thông báo đơn mới/tin nhắn/hủy đơn về kênh Discord (cùng server với Hermes)
DISCORD_WEBHOOK_URL=

# Tile bản đồ (mặc định OpenStreetMap; traffic lớn nên dùng provider riêng như MapTiler/Stadia)
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
